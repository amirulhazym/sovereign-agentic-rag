# ==============================================================================
# Sovereign Agentic RAG — Environment Configuration Template
# Copy to `.env` before running locally or via `docker compose up --build -d`
# ==============================================================================

# --- Runtime Sovereignty Mode (`LOCAL_ONPREM` | `CLOUD_API`) ---
DEFAULT_INFERENCE_MODE=LOCAL_ONPREM

# --- LOCAL_ONPREM (16GB RAM Workstation Tuning) ---
# Use http://localhost:11434/v1 locally, http://host.docker.internal:11434/v1
# from Docker backend to host Ollama, or http://ollama:11434/v1 with --profile local-ollama
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Recommended default (2.78 GB): hf.co/empero-ai/Qwen3.8-4B-Distill-GGUF:Q4_K_M
# High-precision option (5.78 GB): hf.co/empero-ai/Qwen3.8-9B-Distill-GGUF:Q4_K_M
LOCAL_LLM_MODEL=hf.co/empero-ai/Qwen3.8-4B-Distill-GGUF:Q4_K_M
LOCAL_LLM_API_KEY=ollama
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1

# --- CLOUD_API (DeepSeek Prefix Context Caching) ---
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Lightweight Local ONNX Embeddings & Reranker (FastEmbed) ---
EMBEDDING_DENSE_MODEL=BAAI/bge-m3
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
EMBEDDING_DENSE_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FASTEMBED_CACHE_DIR=F:/.cache/fastembed

# --- Persistence & Bounded Agent Invariants ---
QDRANT_URL=http://localhost:6333
# Set QDRANT_LOCAL_PATH to persist Qdrant directly to disk without Docker (leave blank when using Docker qdrant service)
QDRANT_LOCAL_PATH=
QDRANT_COLLECTION_NAME=sovereign_rag_chunks
SQLITE_URL=sqlite+aiosqlite:///./sovereign_rag.db
MAX_RETRIES=2

# --- Next.js Workspace Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
